CLUSTER_ARN=arn:aws:rds:us-east-1:ACCOUNT:cluster:kb-vectors
SECRET_ARN=arn:aws:secretsmanager:us-east-1:ACCOUNT:secret:rds-credentials
DATABASE=postgres
AWS_REGION=us-east-1

# only needed for psycopg versions (query.py, ingest.py)
# Data API versions (query_data_api.py, ingest_data_api.py) only need the above
DATABASE_URL=postgresql://admin:password@cluster.cluster-xyz.us-east-1.rds.amazonaws.com:5432/postgres
